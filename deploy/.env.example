# HD2Lab BabyCare Environment Configuration
PROJECT_NAME="HD2Lab BabyCare"
API_V1_STR="/api/babycare/v1"
SECRET_KEY="generate-a-secure-random-32-byte-hex-string-for-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (SQLite for single-node / PostgreSQL for multi-node)
DATABASE_URL="sqlite:///./babycare.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/babycare_db"

# Storage
UPLOAD_DIR="./uploads"

# Auth Mode: hybrid | hd2lab_proxy | local
AUTH_MODE="hybrid"

# AI Gateway: mock | gemini | llama
AI_PROVIDER="mock"
GEMINI_API_KEY=""
LOCAL_LLAMA_URL="http://127.0.0.1:8080/v1"
